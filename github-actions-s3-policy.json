{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::highly-available-aws-terraform-state-nidhiksha"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::highly-available-aws-terraform-state-nidhiksha/highly-available-aws-infrastructure/terraform.tfstate",
        "arn:aws:s3:::highly-available-aws-terraform-state-nidhiksha/highly-available-aws-infrastructure/terraform.tfstate.tflock"
      ]
    }
  ]
}